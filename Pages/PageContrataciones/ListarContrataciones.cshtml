@page
@model Obligatorio.Pages.Contrataciones.ListarModel
@{
    ViewData["Title"] = "Listado de Contrataciones";
}
<div>
    <h1 class="display-4 text-center">Listado de Contrataciones</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./AltaContrataciones">Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Importe Total</th>
                <th>Saldo Pendiente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Contrataciones != null && Model.Contrataciones.Any())
            {
                @foreach (Dominio.Entidades.Contratacion unaContratacion in Model.Contrataciones)
                {
                    <tr>
                        <td>@unaContratacion.Id</td>
                        <td>@unaContratacion.Fecha.ToShortDateString()</td>
                        <td>@unaContratacion.FechaInicio.ToShortDateString()</td>
                        <td>@unaContratacion.FechaFin.ToShortDateString()</td>
                        <td>@unaContratacion.ImporteTotal</td>
                        <td>@unaContratacion.SaldoPendiente</td>
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./ModificarContrataciones" asp-route-id="@unaContratacion.Id">
                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-danger" asp-page="./EliminarContrataciones" asp-route-id="@unaContratacion.Id">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">
                        No hay Contrataciones ingresadas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
