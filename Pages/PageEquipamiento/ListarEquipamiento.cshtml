@page
@model Obligatorio.Pages.Equipamiento.ListarEquipamientoModel
@{
    ViewData["Title"] = "Listado de Equipamiento";
}
<div>
    <h1 class="display-4 text-center">Listado de Equipamiento</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./AltaEquipamiento">Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Características</th>
                <th>Tipo</th>
                <th>Cantidad Disponible</th>
                <th>Precio Alquiler</th>
                <th>Total Alquiler</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Equipamientos != null && Model.Equipamientos.Any())
            {
                @foreach (Dominio.Entidades.Equipamiento unEquipamiento in Model.Equipamientos)
                {
                    <tr>
                        <td>@unEquipamiento.Id</td>
                        <td>@unEquipamiento.Nombre</td>
                        <td>@unEquipamiento.Descripcion</td>
                        <td>@unEquipamiento.Caracteristicas</td>
                        <td>@unEquipamiento.Tipo</td>
                        <td>@unEquipamiento.CantidadDisponible</td>
                        <td>@unEquipamiento.PrecioAlquiler</td>
                        <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./ModificarEquipamiento" asp-route-id="@unEquipamiento.Id">
                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-danger" asp-page="./EliminarEquipamiento" asp-route-id="@unEquipamiento.Id">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">
                        No hay Equipamientos ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>