@page
@model Obligatorio.Pages.Contrataciones.AltaModel
@{
    ViewData["Title"] = "Agregar Contratación";
}
<div class="text-left">
    <h1 class="display-4 text-center">Agregar una Contratación</h1>
    <hr />
    <form method="post">
        <div class="row">
            <div class="col-sm-4">
                <div class="form-group">
                    <label for="id">ID:</label>
                    <input class="form-control" type="text" name="id" id="id" asp-for="id" disabled />
                </div>
                <div class="form-group">
                    <label for="fecha">Fecha:</label>
                    <input class="form-control" type="date" name="fecha" id="fecha" />
                </div>
                <div class="form-group">
                    <label for="fechaInicio">Fecha de Inicio:</label>
                    <input class="form-control" type="date" name="fechaInicio" id="fechaInicio" />
                </div>
                <div class="form-group">
                    <label for="fechaFin">Fecha de Fin:</label>
                    <input class="form-control" type="date" name="fechaFin" id="fechaFin" />
                </div>
                <div class="form-group">
                    <label for="importeTotal">Importe Total:</label>
                    <input class="form-control" type="number" step="0.01" name="importeTotal" id="importeTotal" />
                </div>
                <div class="form-group">
                    <label for="saldoPendiente">Saldo Pendiente:</label>
                    <input class="form-control" type="number" step="0.01" name="saldoPendiente" id="saldoPendiente" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="mt-2">
                <button class="btn btn-success" type="submit" asp-page-handler="Agregar">Agregar</button>
                <a class="btn btn-warning" asp-page="./ListarContrataciones">Volver</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <br />
        <div class="alert alert-danger" role="alert">
            @Model.Mensaje
        </div>
    }
</div>
