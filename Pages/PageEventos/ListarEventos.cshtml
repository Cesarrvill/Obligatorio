@page
@model Obligatorio.Pages.Eventos.ListarModel
@{
    
    ViewData["Title"] = "Listado de Eventos";
}
<div>
    <h1 class="display-4 text-center">Listado de Eventos</h1>
    <div class="row">
        <div class="col text-right">
            <a class="btn btn-success" asp-page="./AltaEventos">Agregar</a>
        </div>
    </div>
    <table class="table text-center">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Fecha</th>
                <th>TipoEvento</th>
                <th>Ubicación</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Cantidad Asistentes</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Eventos != null && Model.Eventos.Any())
            {
                @foreach (Dominio.Entidades.Evento unEvento in Model.Eventos)
                {

                    <tr>
                        <td>@unEvento.Id</td>
                        <td>@unEvento.Nombre</td>
                        <td>@unEvento.Fecha</td>
                        <td>@unEvento.TipoEvento</td>
                        <td>@unEvento.Ubicacion</td>
                        <td>@unEvento.HoraInicio</td>
                        <td>@unEvento.HoraFin</td>
                        <td>@unEvento.CantAsistentes</td>
                    <td>
                            <div>
                                <a class="btn btn-primary" asp-page="./ModificarEventos" asp-route-id="@unEvento.Id">
                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-danger" asp-page="./EliminarEventos" asp-route-id="@unEvento.Id">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No hay Eventos ingresados
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
